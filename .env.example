# trellis-watchtower local settings. Copy to .env (gitignored) and fill in.
# No real values belong in this file.

# Grafana admin password (Grafana on http://localhost:4390; anonymous users
# get Viewer, and it listens on 127.0.0.1 only).
GRAFANA_ADMIN_PASSWORD=

# postgres_exporter DSNs (profile db; `make up` adds the profile when both are
# set). Use the databases' EXISTING local dev credentials; create no roles.
# Never point these at tpa-db or auth-db.
#   network-db: host.docker.internal:5434, database network
#   forge-db:   host.docker.internal:5433, database forge
PG_DSN_NETWORK=postgresql://USER:PASSWORD@host.docker.internal:5434/network?sslmode=disable
PG_DSN_FORGE=postgresql://USER:PASSWORD@host.docker.internal:5433/forge?sslmode=disable

# Fly hosted Prometheus (Grafana datasource uid `fly`), read-only. Optional.
# FLY_ORG is the org slug (`fly orgs list`). FLY_PROM_TOKEN is the WHOLE
# Authorization header value: for `fly tokens create readonly` that is
# "FlyV1 fm2_..."; for `fly auth token` it is "Bearer <token>".
FLY_ORG=
FLY_PROM_TOKEN=
