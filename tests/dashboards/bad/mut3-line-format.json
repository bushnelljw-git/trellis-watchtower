{
  "uid": "tw-mut3-linefmt",
  "title": "Mutation: line_format then regexp copies the whole line into `where`",
  "panels": [
    {
      "type": "stat",
      "title": "line_format",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (where) (count_over_time({stack=\"tpa\"} | line_format `{{ __line__ }}` | regexp `(?P<where>.*)` [24h]))"
        }
      ]
    }
  ]
}
