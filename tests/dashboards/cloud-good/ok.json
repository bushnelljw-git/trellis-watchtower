    {
      "type": "timeseries",
      "title": "near misses: tenants_total-like names stay fine",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-app"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_count",
              "AND",
              "resource.type",
              "=",
              "cloud_run_revision",
              "AND",
              "resource.label.service_name",
              "=~",
              "web|auth"
            ],
            "groupBys": [
              "resource.label.service_name",
              "metric.label.response_code_class"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL"
          },
          "aliasBy": "{{resource.label.service_name}} {{metric.label.response_code_class}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/up",
              "AND",
              "resource.type",
              "=",
              "cloudsql_database",
              "AND",
              "resource.label.database_id",
              "=",
              "*:auth-db"
            ],
            "groupBys": [
              "resource.label.database_id"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL"
          },
          "aliasBy": ""
        },
        {
          "refId": "C",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "logging.googleapis.com/user/tpa_jobs_runs"
            ],
            "groupBys": [
              "metric.label.job"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL"
          },
          "aliasBy": ""
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "phi alone, groups counted",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-phi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-phi"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_PHI_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "logging.googleapis.com/user/records_refusals",
              "AND",
              "resource.type",
              "=",
              "cloud_run_revision"
            ],
            "groupBys": [
              "metric.label.gate",
              "metric.label.code"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL",
            "secondaryCrossSeriesReducer": "REDUCE_COUNT",
            "secondaryPerSeriesAligner": "ALIGN_SUM",
            "secondaryAlignmentPeriod": "+86400s",
            "secondaryGroupBys": []
          },
          "aliasBy": ""
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}