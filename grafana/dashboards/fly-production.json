    {
      "type": "text",
      "title": "Needs FLY_ORG and FLY_PROM_TOKEN",
      "options": {
        "mode": "markdown",
        "content": "These panels read Fly's hosted Prometheus (datasource `fly`). They need `FLY_ORG` (the org slug) and `FLY_PROM_TOKEN` (a read-only token from `fly tokens create readonly`) in `.env`, then `make up`. Until both are set, every panel in this row shows a datasource error (401): that is missing configuration, not an outage. The laptop probes above (fly-network, fly-portal) do not depend on it.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      },
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Machines up",
      "datasource": {
        "type": "prometheus",
        "uid": "fly"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fly"
          },
          "editorMode": "code",
          "expr": "sum by (app) (fly_instance_up{app=~\"$app\"})",
          "legendFormat": "{{app}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "Machines reporting per app. Every app keeps min_machines_running = 1. These panels read Fly's hosted Prometheus (datasource `fly`). They need `FLY_ORG` (the org slug) and `FLY_PROM_TOKEN` (a read-only token from `fly tokens create readonly`) in `.env`, then `make up`. Until both are set, every panel in this row shows a datasource error (401): that is missing configuration, not an outage. The laptop probes above (fly-network, fly-portal) do not depend on it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "noValue": "no Fly data: set FLY_ORG and FLY_PROM_TOKEN"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 7
