    {
      "type": "stat",
      "title": "Probes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (stack, service, probe) (probe_success{job=\"blackbox\", stack=\"tpa\", service=\"auth\"})",
          "legendFormat": "{{service}} {{probe}}",
          "range": false,
          "instant": true
        }
      ],
      "description": "blackbox probe_success per service and probe (1 = up). ",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no probe (stack not configured)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
