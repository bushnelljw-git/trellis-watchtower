    {
      "type": "stat",
      "title": "auth-publisher: since last line",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "min(min_over_time({stack=\"tpa\", service=\"auth-publisher\"} | label_format age_s=`{{ sub (unixEpoch now) (unixEpoch __timestamp__) }}` | unwrap age_s [1h])) or vector(3600)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Seconds since auth-publisher printed its counts line (one per 50 s loop). It has no probe, and a crashed container stops shipping, so silence is the signal.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 3600,
                "to": null,
