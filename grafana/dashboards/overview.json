{
  "uid": "tw-overview",
  "title": "Stack overview",
  "description": "Home: every watched stack (running, degraded, down, not running), TPA background work read from the logs, and error groups.",
  "tags": [
    "trellis-watchtower",
    "overview"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Stack overview",
      "type": "link",
      "url": "/d/tw-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "tags": [],
      "asDropdown": false,
      "tooltip": ""
    },
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "trellis-watchtower"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link",
      "url": "",
      "tooltip": ""
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Stacks",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Stacks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(label_replace(((stack:probe_success:max_over_time1h == 0)\nor\n  (1 + 0 * count by (stack) (\n      probe_success{job=\"blackbox\"} == 0\n      unless on (instance, probe) (probe_http_status_code{job=\"blackbox\", probe=\"db\"} >= 200 < 300)\n  ))\nor\n  (2 + 0 * count by (stack) (probe_success{job=\"blackbox\"} == 0))\nor\n  (3 + 0 * stack:probe_success:max_over_time1h)), \"dashboard\", \"tw-tpa-edge-api\", \"stack\", \"tpa\"), \"dashboard\", \"tw-crm-network\", \"stack\", \"network\"), \"dashboard\", \"tw-forge\", \"stack\", \"forge\"), \"dashboard\", \"tw-enroll\", \"stack\", \"enroll\"), \"dashboard\", \"tw-feed-ingest\", \"stack\", \"feed-ingest\"), \"dashboard\", \"tw-fly-production\", \"stack\", \"fly\")",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (stack) (probe_success{job=\"blackbox\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count by (stack) (probe_success{job=\"blackbox\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "description": "One row per stack. running: every probe passes. degraded: a health endpoint answers 2xx but its body reports the database down. down: a probe gets no answer or a non-2xx while the stack has been up in the last hour. not running: no probe of the stack passed in the last hour (a repo not started today, not an outage). Click a stack to open its dashboard.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "not running",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "down",
                        "color": "red",
                        "index": 1
                      },
                      "2": {
                        "text": "degraded",
                        "color": "orange",
                        "index": 2
                      },
                      "3": {
                        "text": "running",
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 160
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dashboard"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Stack"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.Stack}",
                    "url": "/d/${__data.fields.dashboard}?${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Stack",
            "desc": false
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {},
            "indexByName": {}
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "stack": "Stack",
              "Value #A": "State",
              "Value #B": "Probes up",
              "Value #C": "Probes"
            },
            "indexByName": {
              "Stack": 0,
              "State": 1,
              "Probes up": 2,
              "Probes": 3
            }
          }
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "state-timeline",
      "title": "Probe history",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (stack, service, probe) (probe_success{job=\"blackbox\"})",
          "legendFormat": "{{stack}} / {{service}} {{probe}}",
          "range": true,
          "instant": false
        }
      ],
      "description": "Every blackbox probe over the time range (green up, red down).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
