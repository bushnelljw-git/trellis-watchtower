  "panels": [
    {
      "type": "row",
      "title": "Liveness (from logs)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "connectors: since last pass",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "min(min_over_time({stack=\"tpa\", service=\"connectors\"} | outcome=\"pass\" | label_format age_s=`{{ sub (unixEpoch now) (unixEpoch __timestamp__) }}` | unwrap age_s [1h])) or vector(3600)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Seconds since connectors last logged outcome=pass. A pass runs at least every 20 s.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 3600,
                "to": null,
                "result": {
                  "text": "none in the last hour",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "links": [
        {
          "title": "Jobs and connectors",
          "url": "/d/tw-jobs-connectors?${__url_time_range}",
          "targetBlank": false,
          "tooltip": ""
        }
      ],
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "tpa-jobs-drains: since last run summary",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "min(min_over_time({stack=\"tpa\", service=\"tpa-jobs-drains\"} |= `\"tenants_total\"` | label_format age_s=`{{ sub (unixEpoch now) (unixEpoch __timestamp__) }}` | unwrap age_s [1h])) or vector(3600)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Seconds since a drain logged its run summary. The drains tick every 30 to 60 s.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 3600,
                "to": null,
                "result": {
                  "text": "none in the last hour",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "links": [
        {
          "title": "Jobs and connectors",
          "url": "/d/tw-jobs-connectors?${__url_time_range}",
