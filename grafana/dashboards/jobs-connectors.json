    {
      "type": "stat",
      "title": "Dead letters",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "max(last_over_time({stack=\"tpa\", service=\"connectors\"} | outcome=\"pass\" | regexp `connectors_dead_total=(?P<n>[0-9]+)` | unwrap n [5m]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Rows given up on since connectors started. Any is an alert. Counters are per process and reset when connectors restarts.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
