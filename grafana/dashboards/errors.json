    {
      "type": "stat",
      "title": "Error groups in range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [$__range]))) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Distinct groups with at least one ERROR line in the time range.",
      "fieldConfig": {
        "defaults": {
          "color": {
