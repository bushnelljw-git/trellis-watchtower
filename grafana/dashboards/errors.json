    {
      "type": "table",
      "title": "Error groups",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "min_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` | label_format seen_ms=`{{ unixEpochMillis __timestamp__ }}` | unwrap seen_ms [$__range]) by (service, exc_class, where, sqlstate)",
          "legendFormat": "",
          "queryType": "instant"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk by (service, exc_class, where, sqlstate) (1, max_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` | json release=\"revision\" | label_format seen_ms=`{{ unixEpochMillis __timestamp__ }}` | unwrap seen_ms [$__range]) by (service, exc_class, where, sqlstate, release))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "One row per error group: service, exception class, operation (or route template) and SQLSTATE, over lines with level=ERROR. Count, first seen and last seen are within the time range. Release comes from the newest line and is filled only where a service logs one (auth's revision). Lines carry the class only: no message, no stack trace (docs/SPEC.md).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "First seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Count"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {},
            "indexByName": {}
