    {
      "type": "stat",
      "title": "New groups, last 24 h",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count(sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [24h])) unless sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [6d] offset 1d))) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Seen in the last 24 h and not in the 6 days before (Loki keeps 7 days).",
