        "definition": "label_values({stack=~\"$stack\"}, service)",
        "query": {
          "type": 1,
          "label": "service",
          "stream": "{stack=~\"$stack\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
