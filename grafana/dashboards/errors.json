        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count((sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [1h])) > 10) and (sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [1h])) > 5 * sum by (service, exc_class, where, sqlstate) (count_over_time({stack=~\"$stack\", service=~\"$service\"} | level=\"ERROR\" | label_format where=`{{ or .operation .route }}` [7d])) / 168)) or vector(0)",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "description": "Last hour's count over 10 and over 5x the group's 7-day hourly average. The same rule as the production spike alert.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
