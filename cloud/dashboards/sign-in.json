    {
      "type": "stat",
      "title": "auth-db",
      "description": "Cloud SQL's own signals for auth-db: `database/up` (the urgent `auth-db-down` pages below 1 for five minutes) and disk used (`auth-db-disk` at 85% for ten minutes). \"database stopped\": stopped on purpose between test sessions (beta's database_activation_policy NEVER; the service's TPA_STOPPED_DATABASES). \"not reporting\": no value, and not listed as stopped: not built (cc-db exists with the staffed desk only), or reporting nothing.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-app"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/up",
              "AND",
              "resource.type",
              "=",
              "cloudsql_database",
              "AND",
              "resource.label.database_id",
              "=",
              "*:auth-db"
            ],
            "groupBys": [
              "resource.label.database_id"
            ],
            "crossSeriesReducer": "REDUCE_MIN",
            "perSeriesAligner": "ALIGN_MIN",
            "alignmentPeriod": "+60s",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "auth-db up"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/disk/utilization",
              "AND",
              "resource.type",
              "=",
              "cloudsql_database",
              "AND",
              "resource.label.database_id",
              "=",
              "*:auth-db"
            ],
            "groupBys": [
              "resource.label.database_id"
            ],
            "crossSeriesReducer": "REDUCE_MAX",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "+300s",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "auth-db disk"
        }
      ],
      "interval": "1m",
      "timeFrom": "15m",
      "hideTimeOverride": true,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "noValue": "@@R,auth-db,@@not reporting@@"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "up"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "disk"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.75
                    },
                    {
                      "color": "red",
                      "value": 0.85
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
