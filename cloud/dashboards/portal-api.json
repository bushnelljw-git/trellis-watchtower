    {
      "type": "timeseries",
      "title": "Uptime checks passing, by host",
      "description": "Share of checker regions passing, by host. @@E@@Each check reads `/health` on a public host (the portal, auth and api hosts) from three US regions: a pass is the service answering through the load balancer and Cloud Armor. An outage pages when more than one region fails.@@Beta's hosts are behind IAP, so a check passes only on Google's sign-in page: it proves the address, the certificate, Cloud Armor and IAP, never the service behind them (that is the 5xx and instance panels). An outage pages when more than one region fails.@@",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-app"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "monitoring.googleapis.com/uptime_check/check_passed",
              "AND",
              "resource.type",
              "=",
              "uptime_url"
            ],
            "groupBys": [
              "resource.label.host"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "{{resource.label.host}}"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "IAP assertions refused, and stale pinned keys",
      "description": "auth's or tpa-api's refusals of an IAP assertion under a key the image does not pin (urgent `iap-unknown-key`: most likely Google rotated IAP's keys), and the image's own warning that its keys are stale. Silent while beta runs with the header check off (R302).",
