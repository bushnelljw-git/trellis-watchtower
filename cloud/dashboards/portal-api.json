          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "logging.googleapis.com/user/iap_unknown_key",
              "AND",
              "resource.type",
              "=",
              "cloud_run_revision"
            ],
            "groupBys": [
              "resource.label.service_name"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "refused: {{resource.label.service_name}}"
        },
