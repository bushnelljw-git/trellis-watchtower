    {
      "type": "timeseries",
      "title": "Requests, by service and status class",
      "description": "Requests Cloud Run answered per interval. A refused webhook signature is a 4xx.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
