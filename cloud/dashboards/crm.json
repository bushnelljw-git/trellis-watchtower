    {
      "type": "timeseries",
      "title": "Uptime check passing",
      "description": "The CRM host's check (beta, once its certificate is active and `crm_uptime_check_enabled` is on). Behind IAP it passes on Google's sign-in page.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-crm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-crm"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_CRM_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "monitoring.googleapis.com/uptime_check/check_passed",
              "AND",
              "resource.type",
              "=",
              "uptime_url",
              "AND",
              "resource.label.host",
              "=",
              "crm.*"
            ],
            "groupBys": [
              "resource.label.host"
            ],
            "crossSeriesReducer": "REDUCE_MEAN",
            "perSeriesAligner": "ALIGN_FRACTION_TRUE",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "{{resource.label.host}}"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2
    },
