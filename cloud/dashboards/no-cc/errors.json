    {
      "type": "table",
      "title": "Error groups in the time range (errors)",
      "description": "Every error group of `errors` in the time range: the Cloud Run service or job, then the counter's labels, and its ERROR lines. A line carries an exception's class and never its message or a stack trace. A group new in the last hour (absent the 23 before) opens the `new error group` policy.",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "stackdriver",
        "uid": "cloud-app"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "__TPA_APP_PROJECT_ID__",
            "filters": [
              "metric.type",
              "=",
              "logging.googleapis.com/user/errors",
              "AND",
              "resource.type",
              "=",
              "cloud_run_revision"
            ],
            "groupBys": [
              "resource.label.service_name",
              "metric.label.service",
              "metric.label.class",
              "metric.label.operation",
              "metric.label.code"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_DELTA",
            "alignmentPeriod": "grafana-auto",
            "view": "FULL",
            "preprocessor": "none"
          },
          "aliasBy": "{{resource.label.service_name}} {{metric.label.service}} {{metric.label.class}} {{metric.label.operation}} {{metric.label.code}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloud-app"
